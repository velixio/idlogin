# Copied to $IDLOGIN_DEV_HOME/secrets/local.env by scripts/dev-up.sh, which
# fills the secrets and replaces @IDLOGIN_DEV_HOME@ with that directory.
# Never commit the filled-in file.

# --- zitadel (Go API, console, OIDC) ---
ZITADEL_MASTERKEY=REPLACE_ME_32_CHARS
ZITADEL_DATABASE_POSTGRES_USER_PASSWORD=REPLACE_ME
ZITADEL_DATABASE_POSTGRES_ADMIN_PASSWORD=REPLACE_ME
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORD=REPLACE_ME
ZITADEL_FIRSTINSTANCE_LOGINCLIENTPATPATH=@IDLOGIN_DEV_HOME@/secrets/login-client.pat
ZITADEL_FIRSTINSTANCE_PATPATH=@IDLOGIN_DEV_HOME@/secrets/provisioner.pat

# --- idlogin (sign-in service, cmd/idlogin) ---
LOGIN_ADDR=127.0.0.1:8091
LOGIN_ZITADEL_URL=http://localhost:8090
LOGIN_BRANDS_FILE=@IDLOGIN_DEV_HOME@/idlogin/brands.json
LOGIN_DATABASE_URL=postgres://idlogin@127.0.0.1:5432/idlogin?sslmode=disable
LOGIN_DATABASE_PASSWORD=REPLACE_ME
# base64 of 32 random bytes; seals cookies and keys the code hashes.
LOGIN_COOKIE_KEY=REPLACE_ME
LOGIN_MAILER=log
LOGIN_MAIL_DIR=@IDLOGIN_DEV_HOME@/mail
# Enables the Zitadel action target (preaccesstoken) on LOGIN_ADDR.
LOGIN_ACTIONS_SIGNING_KEY_FILE=@IDLOGIN_DEV_HOME@/secrets/login-actions.key
