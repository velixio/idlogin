# Install as /etc/idlogin/idlogin.env (root:root, 0600; systemd reads it as
# root). Fill every REPLACE_ME; idlogin.service refuses to start while one is
# left. See docs/idlogin.md for every variable.

LOGIN_ADDR=127.0.0.1:8091
LOGIN_ZITADEL_URL=http://127.0.0.1:8090
LOGIN_BRANDS_FILE=/etc/idlogin/brands.json
LOGIN_DATABASE_URL=postgres://idlogin@127.0.0.1:5432/idlogin?sslmode=disable
# Also used by deploy/postgres/create-db.sh to create the idlogin role.
LOGIN_DATABASE_PASSWORD=REPLACE_ME
# openssl rand -base64 32. Rotating it signs every browser out of pending flows.
LOGIN_COOKIE_KEY=REPLACE_ME
# nginx sets X-Forwarded-For to the client address.
LOGIN_TRUST_PROXY=true

LOGIN_MAILER=smtp
LOGIN_SMTP_HOST=REPLACE_ME
LOGIN_SMTP_PORT=587
LOGIN_SMTP_USER=REPLACE_ME
LOGIN_SMTP_PASSWORD=REPLACE_ME
# starttls | tls (implicit, port 465) | none
LOGIN_SMTP_TLS=starttls

# Zitadel action target (adds email/email_verified to JWT access tokens),
# served on LOGIN_ADDR at /login/zitadel/preaccesstoken and reached by
# Zitadel through the public hostname. It is enabled by the signing key,
# /etc/idlogin/actions.key (written by `idlogin setup`), handed to the
# service as a systemd credential (idlogin.service).
