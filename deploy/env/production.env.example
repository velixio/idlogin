# Install as /etc/zitadel/zitadel.env (root:zitadel, 0640). Fill every
# REPLACE_ME; the unit refuses to start while one is left (ExecStartPre).
# Generate values with: head -c 48 /dev/urandom | base64 | tr -dc A-Za-z0-9 | head -c 32
# The sign-in service has its own file: idlogin.production.env.example.

# --- zitadel ---
# Exactly 32 characters. Losing it makes every encrypted secret unreadable:
# back it up separately from the database backups.
ZITADEL_MASTERKEY=REPLACE_ME
ZITADEL_DATABASE_POSTGRES_USER_PASSWORD=REPLACE_ME
ZITADEL_DATABASE_POSTGRES_ADMIN_PASSWORD=REPLACE_ME
# Only read by the first `setup`; change the password in the console afterwards.
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORD=REPLACE_ME
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_EMAIL_ADDRESS=REPLACE_ME
ZITADEL_FIRSTINSTANCE_LOGINCLIENTPATPATH=/var/lib/zitadel/login-client.pat
ZITADEL_FIRSTINSTANCE_PATPATH=/var/lib/zitadel/provisioner.pat
